<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glass_fallback" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header: art, title/artist, controls -->
        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_art"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/widget_text_col"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/widget_song_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <ImageView
                    android:id="@+id/widget_artist_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
            <ImageButton
                android:id="@+id/widget_btn_prev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/widget_previous"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_skip_previous" />
            <ImageButton
                android:id="@+id/widget_btn_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/widget_play_pause"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wp_play" />
            <ImageButton
                android:id="@+id/widget_btn_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/widget_next"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_skip_next" />
            </LinearLayout>
        </LinearLayout>

        <!-- Controls under the header (3 columns and wider, 2+ rows) -->
        <LinearLayout
            android:id="@+id/widget_controls_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">
            <ImageButton
                android:id="@+id/widget_btn_prev_row"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/widget_previous"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_skip_previous" />
            <ImageButton
                android:id="@+id/widget_btn_play_row"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/widget_play_pause"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wp_play" />
            <ImageButton
                android:id="@+id/widget_btn_next_row"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/widget_next"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_skip_next" />
        </LinearLayout>

        <!-- Narrow stack: title/artist under the art -->
        <LinearLayout
            android:id="@+id/widget_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">
            <ImageView
                android:id="@+id/widget_info_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <ImageView
                android:id="@+id/widget_info_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Up next -->
        <LinearLayout
            android:id="@+id/widget_queue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/widget_q_col_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <ImageView android:id="@+id/widget_q_label_1" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <ImageView android:id="@+id/widget_q_card_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/widget_q_col_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <ImageView android:id="@+id/widget_q_label_2" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <ImageView android:id="@+id/widget_q_card_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ImageButton
                android:id="@+id/widget_btn_play_big"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/widget_play_pause"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wp_play"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Recommendations -->
        <LinearLayout
            android:id="@+id/widget_recs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
